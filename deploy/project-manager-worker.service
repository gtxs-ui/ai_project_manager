[Unit]
Description=Project Manager Worker
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/project_manager
EnvironmentFile=-/opt/project_manager/.env
ExecStart=/opt/project_manager/venv/bin/python3 /opt/project_manager/pm_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/project_manager/data/pm/worker_stdout.log
StandardError=append:/opt/project_manager/data/pm/worker_stdout.log
ReadWritePaths=/opt/project_manager /root/.claude

[Install]
WantedBy=multi-user.target
