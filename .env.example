# Telegram bot for the Project Manager
# Create a new bot via @BotFather — use a DIFFERENT bot from other agents
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (same as other agents — it's your user ID)
# Find it: send any message to your bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Look for "chat":{"id": 123456789}
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Claude auth — pick ONE path:
#
# Option A: OAuth / Claude subscription (default for interactive setup)
#   Leave ANTHROPIC_API_KEY blank below. After install.sh, run `claude` once
#   interactively and complete browser sign-in. Credentials land in ~/.claude/
#   and persist across systemd restarts.
#
# Option B: API key (recommended for headless / fully unattended VPS install)
#   Fill in ANTHROPIC_API_KEY with sk-ant-... and the Claude CLI will use
#   the API directly (no OAuth required). The systemd unit loads this file
#   via EnvironmentFile so the key is in scope automatically.
#   Get a key at https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
